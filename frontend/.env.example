# Copy to .env.local for local development.
# Leave VITE_API_URL empty in dev: /api is proxied to VITE_API_PROXY_TARGET (no CORS needed).
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Comma-separated capabilities to read from the API instead of the preview store, once their
# backend modules are merged, e.g. clinicalRecords,tgaApprovals
VITE_API_FEATURES=
