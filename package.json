{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "build": "bun run --filter frontend build",
    "check:budget": "bun run --filter frontend check:budget",
    "typecheck": "bun run --filter frontend typecheck",
    "lint": "bun run --filter frontend lint",
    "lint:ci": "bun run --filter frontend lint:ci",
    "test": "bun run --filter frontend test",
    "test:ui": "bun run --filter frontend test:ui",
    "generate-client": "bun run --filter frontend generate-client",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
