{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend-features",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "dev:features": "bun run --filter frontend-features dev",
    "lint": "bun run --filter frontend lint",
    "lint:features": "bun run --filter frontend-features lint",
    "test": "bun run --filter frontend test",
    "test:features": "bun run --filter frontend-features test",
    "test:ui": "bun run --filter frontend test:ui",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
