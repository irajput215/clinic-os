# Copy to .env and replace every value marked REPLACE_ME.
# Never commit .env — it is gitignored.
#
# Generate strong values, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

# Signs JWTs. Anyone holding this value can mint tokens — REPLACE_ME.
SECRET_KEY=REPLACE_ME

FIRST_SUPERUSER=admin@example.com
# REPLACE_ME
FIRST_SUPERUSER_PASSWORD=REPLACE_ME

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
# REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Required by compose.deploy.yml (Traefik + Let's Encrypt). The public hostname.
DOMAIN=REPLACE_ME

# Seed one demo organisation on startup (initial_data.py). MVP convenience:
# leave false in a real environment, where tenants are onboarded, not seeded.
SEED_DEMO_TENANT=false

# Self-registration at POST /api/v1/users/signup. Open: a signup carries a clinic name
# and registers that organisation, so a new account can only reach the tenant it
# created. Set false to require every account to be provisioned by an administrator.
USERS_OPEN_REGISTRATION=true

# Sliding-window rate limiting on login and password recovery (429 + Retry-After).
# Per process, keyed on the client address in the ASGI scope: see
# app/core/rate_limit.py for what that means behind a proxy.
RATE_LIMIT_ENABLED=true
