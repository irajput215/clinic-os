# Copy to .env and replace every value marked REPLACE_ME.
# Never commit .env — it is gitignored.
#
# Generate strong values, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="ClinicOS"

# Signs JWTs. Anyone holding this value can mint tokens — REPLACE_ME.
SECRET_KEY=REPLACE_ME

FIRST_SUPERUSER=admin@example.com
# REPLACE_ME
FIRST_SUPERUSER_PASSWORD=REPLACE_ME

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
# REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Optional. Migrations run as a role that owns the schema, while the application runs as the
# least-privilege `clinos_app`; leave this unset and Alembic uses DATABASE_URL as before.
# MIGRATION_DATABASE_URL=postgresql://clinos_migrator:REPLACE_ME@localhost:5432/app

# Optional. The URL that serves the app (the backend serves it at `/`): the only CORS origin and
# the base of every emailed link (password reset). Unset, it is http://localhost:8000, the backend
# itself; uncomment for the Vite dev server. In production it is the public URL: a FastAPI Cloud
# application environment variable, or https://$DOMAIN by default under compose.deploy.yml. Left
# commented so a copied .env never overrides that default with a local URL.
# FRONTEND_HOST=http://127.0.0.1:5174

# Required by compose.deploy.yml (Traefik + Let's Encrypt). The public hostname.
DOMAIN=REPLACE_ME

# Seed one demo organisation on startup (initial_data.py). MVP convenience:
# leave false in a real environment, where tenants are onboarded, not seeded.
SEED_DEMO_TENANT=false

# Self-registration at POST /api/v1/users/signup. Open: a signup carries a clinic name
# and registers that organisation, so a new account can only reach the tenant it
# created. Set false to require every account to be provisioned by an administrator.
USERS_OPEN_REGISTRATION=true

# Sliding-window rate limiting (429 + Retry-After) on login, signup, password recovery and the
# administrative and read classes. Per process; keyed on the session when the request carries a
# valid token, otherwise on the client address in the ASGI scope: see app/core/rate_limit.py for
# what that means behind a proxy.
RATE_LIMIT_ENABLED=true
